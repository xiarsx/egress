# egress environment configuration — copy to .env and adjust.
# Canonical prefix is EGRESS_*; a missing EGRESS_* falls back to the
# legacy RESIN_* name once (with a deprecation warning).

# --- Listener ---
# Address the HTTP forward proxy binds (the main data-plane port).
EGRESS_LISTEN_ADDRESS=0.0.0.0
EGRESS_PORT=2260

# --- Tokens (both required; proxy token may be empty for no-auth mode) ---
# Guards the control-plane API: Authorization: Bearer <token>.
EGRESS_ADMIN_TOKEN=change-me-admin
# V1 line-protocol token (Proxy-Authorization / SOCKS5 password).
# Empty (but set) = no-auth mode: forward proxy accepts requests without
# credentials and SOCKS5 accepts NO AUTH.
EGRESS_PROXY_TOKEN=change-me-proxy

# --- Data directories ---
EGRESS_STATE_DIR=/var/lib/egress     # state.db (strong source of truth)
EGRESS_CACHE_DIR=/var/cache/egress   # cache.db + metrics.db (weak, rebuildable)
EGRESS_LOG_DIR=/var/log/egress       # rolling request-log DBs

# --- Declarative config file (optional) ---
# Applied at startup on top of the built-in Default platform.
# See egress.yaml.example.
EGRESS_CONFIG=

# --- Extra listeners (optional) ---
# SOCKS5 ingress. When unset: same host as EGRESS_LISTEN_ADDRESS, port 2261.
# Set to empty to disable.
#EGRESS_SOCKS_LISTEN=127.0.0.1:2261
# Control-plane API + reverse proxy (+ WebUI /ui/ when available).
# When unset: same host as EGRESS_LISTEN_ADDRESS, port 2262.
# Set to empty to disable.
#EGRESS_API_LISTEN=127.0.0.1:2262

# --- GeoIP (optional) ---
# Path to a MaxMind .mmdb (e.g. GeoLite2-City.mmdb). Empty = GeoIP
# enrichment disabled; node attrs stay empty until configured.
EGRESS_GEOIP_DB=
